<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Movie_app" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main theme colors -->
        <item name="colorPrimary">@color/black_deep</item>
        <item name="colorSecondary">@color/red_accent</item>
        <item name="android:windowBackground">@color/black_deep</item>
        <item name="colorSurface">@color/black_deep</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/black_card</item>
        
        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/black_deep</item>
        <item name="android:navigationBarColor">@color/black_deep</item>
        
        <!-- Remove Material 3 selection pill -->
        <item name="colorSecondaryContainer">@android:color/transparent</item>
        <item name="colorOnSecondaryContainer">@color/red_accent</item>
        
        <!-- Bottom Navigation Customization -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigationView</item>
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
        <item name="backgroundTint">@color/black_deep</item>
        <item name="elevation">0dp</item>
        <item name="itemRippleColor">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.App.BottomNavigationView" parent="">
        <item name="colorPrimary">@color/red_accent</item>
        <item name="colorSecondaryContainer">@android:color/transparent</item>
        <item name="colorOnSecondaryContainer">@color/red_accent</item>
    </style>

    <style name="Theme.Movie_app" parent="Base.Theme.Movie_app" />
</resources>